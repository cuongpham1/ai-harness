{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node scripts/hooks/cursor/session-start.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node scripts/hooks/cursor/before-shell.mjs",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "node scripts/hooks/cursor/pre-tool-content-guard.mjs",
        "failClosed": true
      },
      {
        "matcher": "Task",
        "command": "node scripts/hooks/pre-agent-codegraph.mjs",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "node scripts/hooks/cursor/post-tool-use.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node scripts/hooks/cursor/subagent-telemetry.mjs start"
      }
    ],
    "subagentStop": [
      {
        "command": "node scripts/hooks/cursor/subagent-telemetry.mjs stop"
      }
    ],
    "stop": [
      {
        "command": "node scripts/hooks/cursor/stop-handoff.mjs",
        "loop_limit": 3
      },
      {
        "command": "node scripts/hooks/cursor/stop-sync-trace.mjs"
      },
      {
        "command": "node scripts/hooks/cursor/stop-export-langfuse.mjs"
      },
      {
        "command": "node scripts/hooks/cursor/stop-score-trace.mjs"
      },
      {
        "command": "node scripts/hooks/cursor/stop-verify.mjs",
        "loop_limit": 2
      },
      {
        "command": "node scripts/hooks/cursor/stop-sync-story.mjs"
      },
      {
        "command": "node scripts/hooks/cursor/stop-checkpoint.mjs"
      }
    ]
  }
}